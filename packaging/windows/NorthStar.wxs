<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NorthStar Prototype" Manufacturer="NorthStar contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="503887AC-B780-46CF-9B87-CFCA86767445"
           Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer NorthStar version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="NorthStar" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="NorthStarMenu" Name="NorthStar" />
    </StandardDirectory>

    <Feature Id="Main" Title="NorthStar Prototype" Level="1">
      <ComponentRef Id="DesktopExecutable" />
      <ComponentRef Id="ProjectLicense" />
      <ComponentRef Id="FontNotices" />
      <ComponentRef Id="PlexLicense" />
      <ComponentRef Id="PrototypeGuide" />
      <ComponentRef Id="RecoveryGuide" />
      <ComponentRef Id="NavigationGuide" />
      <ComponentRef Id="WordNavigationGuide" />
      <ComponentRef Id="FindGuide" />
      <ComponentRef Id="DeletionGuide" />
      <ComponentRef Id="BackspaceDeleteGuide" />
      <ComponentRef Id="ErasureGuide" />
      <ComponentRef Id="WordErasureGuide" />
    </Feature>

    <Component Id="DesktopExecutable" Directory="INSTALLFOLDER" Guid="08FBB73A-5EFD-48DE-8D56-3036D8ECFFC1">
      <File Id="DesktopFile" Source="$(var.DesktopExecutable)" Name="northstar-desktop.exe">
        <Shortcut Id="StartMenuShortcut" Directory="NorthStarMenu" Name="NorthStar Prototype"
                  Description="NorthStar WordStar 4.0 reconstruction prototype"
                  WorkingDirectory="INSTALLFOLDER" />
      </File>
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveNorthStarMenu" Directory="NorthStarMenu" On="uninstall" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>
    <Component Id="ProjectLicense" Directory="INSTALLFOLDER" Guid="3A18DF82-64D5-41BB-B987-31ED66609DCE">
      <File Source="$(var.RepoRoot)\LICENSE" Name="LICENSE.txt" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="License" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="FontNotices" Directory="INSTALLFOLDER" Guid="B04BF44E-694E-48FE-802D-9D97F35BBFB0">
      <File Source="$(var.RepoRoot)\THIRD_PARTY_FONTS.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="FontNotices" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="PlexLicense" Directory="INSTALLFOLDER" Guid="F5F66250-5E04-48A9-9CA9-50F210C4C3F0">
      <File Source="$(var.RepoRoot)\crates\northstar-desktop\assets\fonts\IBM-Plex-OFL.txt" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="PlexLicense" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="PrototypeGuide" Directory="INSTALLFOLDER" Guid="2C7EA8C3-B606-4246-B626-E460B04B7601">
      <File Source="$(var.RepoRoot)\docs\WINDOWS_PROTOTYPE.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="Guide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="RecoveryGuide" Directory="INSTALLFOLDER" Guid="3AA98D6B-46B9-419B-8D7A-DBCFEEB6B57E">
      <File Source="$(var.RepoRoot)\docs\RECOVERY.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="RecoveryGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="NavigationGuide" Directory="INSTALLFOLDER" Guid="7726B1C3-F8C5-421A-BDAB-1DC030ABFAB0">
      <File Source="$(var.RepoRoot)\docs\NAVIGATION.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="NavigationGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="WordNavigationGuide" Directory="INSTALLFOLDER" Guid="78B03A14-0FC7-4544-8527-B25660AFA32B">
      <File Source="$(var.RepoRoot)\docs\WORD_NAVIGATION.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="WordNavigationGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="FindGuide" Directory="INSTALLFOLDER" Guid="1023F0D5-BEA3-4E05-839F-C6AB23D0F853">
      <File Source="$(var.RepoRoot)\docs\FIND.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="FindGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DeletionGuide" Directory="INSTALLFOLDER" Guid="81D76939-872B-474C-8D26-C271B07A0848">
      <File Source="$(var.RepoRoot)\docs\DELETION.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="DeletionGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="BackspaceDeleteGuide" Directory="INSTALLFOLDER" Guid="EA4D734D-1A65-4C87-98FA-477B1456D1E0">
      <File Source="$(var.RepoRoot)\docs\BACKSPACE_DELETE.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="BackspaceDeleteGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ErasureGuide" Directory="INSTALLFOLDER" Guid="AF80B827-5F1D-49FB-8A59-D7CAD644C4C2">
      <File Source="$(var.RepoRoot)\docs\ERASURE.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="ErasureGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="WordErasureGuide" Directory="INSTALLFOLDER" Guid="C55AF3E9-FC4F-43A2-B645-CBE0AD038615">
      <File Source="$(var.RepoRoot)\docs\WORD_ERASURE.md" />
      <RegistryValue Root="HKCU" Key="Software\NorthStar\Prototype" Name="WordErasureGuide" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
